DJANGO_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-before-production
AI_SECRET_KEY=change-me-before-production-ai
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEARNING_EVENT_QUARANTINE_KEY=
LEARNING_EVENT_QUARANTINE_RETENTION_DAYS=7
# dual_required: V1/V2 must both succeed; v1_only: emergency rollback mode.
LEARNING_EVENT_WRITE_MODE=dual_required
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
DJANGO_CROSS_ORIGIN_OPENER_POLICY=

# Use sqlite for local bootstrap when PostgreSQL is not installed.
# Set DATABASE_ENGINE=postgresql after private PostgreSQL deployment is ready.
DATABASE_ENGINE=sqlite
DATABASE_NAME=storage/dev.sqlite3
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=xlzxedu
DATABASE_PASSWORD=xlzxedu_local_password
# Local SQLite only: wait briefly for short Web/worker write overlaps.
SQLITE_TIMEOUT_SECONDS=30

REDIS_URL=redis://127.0.0.1:6379/0
# Local single-process development can use memory. School deployment must use redis.
CHANNEL_LAYER_BACKEND=memory
# Local single-host fallback for curriculum document processing. The web/API
# process is the producer; start_curriculum_ocr_worker.ps1 overrides the worker
# process role. Production must use the Redis values shown below instead.
CELERY_BROKER_URL=filesystem://
CELERY_RESULT_BACKEND=disabled://
CURRICULUM_CELERY_FILESYSTEM_ROLE=producer
CURRICULUM_CELERY_FILESYSTEM_ROOT=storage/celery/curriculum_ocr
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# CELERY_VISIBILITY_TIMEOUT=14400
CURRICULUM_OCR_TASK_SOFT_TIME_LIMIT=10800
CURRICULUM_OCR_TASK_TIME_LIMIT=11100
CURRICULUM_PROCESSING_STALE_SECONDS=1800
# Deployment version or Git commit recorded in analytics pipeline runs.
ANALYTICS_CODE_VERSION=

MEDIA_ROOT=storage/media
STATIC_ROOT=storage/static

MLFLOW_TRACKING_URI=file:storage/mlruns
MODEL_ARTIFACT_ROOT=storage/models
MODEL_PACKAGE_ROOT=storage/model_packages
MODEL_SIGNING_PRIVATE_KEY_PATH=storage/keys/model_signing_private.pem
MODEL_SIGNING_PUBLIC_KEY_PATH=storage/keys/model_signing_public.pem
# Local development can create an Ed25519 key pair on first publish. School production setup must generate keys explicitly.
MODEL_SIGNING_AUTO_CREATE=true

ONLYOFFICE_DOCUMENT_SERVER_URL=http://127.0.0.1
# If ONLYOFFICE JWT is enabled, set this to the same secret in DocumentServer config/local.json.
ONLYOFFICE_JWT_SECRET=
