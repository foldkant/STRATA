  author  = { Jacobs, Abigail Z. and Wallach, Hanna },
  title   = {{Measurement and Fairness}},
  journal = {Proceedings of the 2021 ACM Conference on Fairness, Accountability, and Transparency},
  year    = {2021},
  pages   = {375--385},
  doi     = {10.1145/3442188.3445901},
