{
  "name": "strata-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/preserve-build-manifest.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "postbuild": "node scripts/prune-build-assets.mjs",
    "assets:prune:dry": "node scripts/prune-build-assets.mjs --dry-run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/core-workflows.spec.ts",
    "test:visual-audit": "playwright test e2e/visual-audit.spec.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.45.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "echarts": "^6.1.0",
    "pinia": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
